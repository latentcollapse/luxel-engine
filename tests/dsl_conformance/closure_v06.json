      "kind": "canonical_order",
      "dependency_permutations": [
        [
          {"module_id": "demo.z", "semantic_digest": "sha256:0202020202020202020202020202020202020202020202020202020202020202", "document_digest": null},
          {"module_id": "demo.a", "semantic_digest": "sha256:0101010101010101010101010101010101010101010101010101010101010101", "document_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"}
        ],
        [
          {"module_id": "demo.a", "semantic_digest": "sha256:0101010101010101010101010101010101010101010101010101010101010101", "document_digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"},
          {"module_id": "demo.z", "semantic_digest": "sha256:0202020202020202020202020202020202020202020202020202020202020202", "document_digest": null}
        ]
      ],
      "expected_dependency_order": ["demo.a", "demo.z"],
      "declaration_dag": [
        {"id": "demo.asset:world", "depends_on": []},
        {"id": "demo.asset:sword", "depends_on": ["demo.asset:blade", "demo.asset:guard"]},
        {"id": "demo.asset:guard", "depends_on": []},
        {"id": "demo.asset:blade", "depends_on": []}
      ],
      "expected_declaration_order": [
        "demo.asset:blade",
        "demo.asset:guard",
        "demo.asset:sword",
        "demo.asset:world"
      ],
      "semantic_sequence_reorder": {
        "left": ["transform.translate", "transform.rotate"],
        "right": ["transform.rotate", "transform.translate"],
        "expected_digest_equal": false
      }
