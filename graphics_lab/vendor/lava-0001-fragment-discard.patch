 end
 
+# Fragment-only block terminator: OpKill. The fragment writes nothing,
+# colour or depth.
+@inline function discard()
+    Base.llvmcall(("""
+        declare void @lava_gfx_discard() #0
+        define void @entry() #0 {
+            call void @lava_gfx_discard()
+            ret void
+        }
+        attributes #0 = { alwaysinline }
+    """, "entry"), Cvoid, Tuple{})
+end
+push!(KNOWN_INTRINSICS, "lava_gfx_discard")
